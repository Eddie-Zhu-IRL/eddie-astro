
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
  title = "Eddie Zhu | Actuarial & Data Analytics Portfolio",
  description = "Portfolio showcasing actuarial science, statistics, insurance analytics, claims reserving, pricing and data analytics projects."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- SEO -->
    <meta name="description" content={description} />

    <meta name="author" content="Eddie Zhu" />

    <meta name="robots" content="index, follow" />

    <title>{title}</title>

    <!-- Browser theme -->
    <meta name="theme-color" content="#142B49" />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <!-- Open Graph: LinkedIn and social media previews -->
    <meta property="og:type" content="website" />

    <meta property="og:site_name" content="Eddie Zhu Portfolio" />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:locale" content="en_IE" />

  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
