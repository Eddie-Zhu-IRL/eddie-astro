
---
interface Props {
  title: string;
  category: string;
  description: string;
  technologies: string[];
  href?: string;
  linkLabel?: string;
  image?: string;
  featured?: boolean;
}

const {
  title,
  category,
  description,
  technologies,
  href,
  linkLabel = "View project",
  image,
  featured = false
} = Astro.props;
---

<article class:list={["project-card", { featured }]}>
  {image && (
    <div class="project-image">
      <img src={image} alt={`${title} project screenshot`} />
    </div>
  )}

  <div class="project-content">
    <p class="category">{category}</p>

    <h3>{title}</h3>

    <p class="description">{description}</p>

    <div class="technologies">
      {technologies.map((technology) => (
        <span>{technology}</span>
      ))}
    </div>

    {href ? (
      <a
        href={href}
        class="project-link"
        target={href.startsWith("http") ? "_blank" : undefined}
        rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
      >
        {linkLabel} →
      </a>
    ) : (
      <span class="coming-soon">Detailed case study coming soon</span>
    )}
  </div>
</article>

<style>
  .project-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(20, 43, 73, 0.08);
  }

  .project-image img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    display: block;
  }

  .project-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .category {
    color: var(--color-blue);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  h3 {
    color: var(--color-navy);
    font-size: 1.25rem;
  }

  .description {
    color: var(--color-muted);
    line-height: 1.7;
    flex: 1;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 15px 0 20px;
  }

  .technologies span {
    background: #EFF6FF;
    color: #1D4ED8;
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 0.8rem;
  }

  .project-link {
    color: var(--color-blue);
    font-weight: 600;
  }

  .coming-soon {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>
