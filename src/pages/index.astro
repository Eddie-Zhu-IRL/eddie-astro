
---
import MainLayout from "../layouts/MainLayout.astro";

const projects = [
  {
    title: "Loss Reserve Chain Ladder Model",
    category: "Actuarial Reserving",
    description:
      "An Excel-based reserving model applying the Chain Ladder method, with independent validation using R and Python - AgeUlt LDF, Ult Loss, IBNR.",
    technologies: ["Excel", "VBA", "R", "Python"],
    github:
      "https://github.com/Eddie-Zhu-IRL/Loss-Reserve-Chain-Ladder-Model",
    featured: true
  },
  {
    title: "Insurance Portfolio Analysis By Power BI",
    category: "Insurance Reporting",
    description:
      "An interactive Power BI dashboard exploring motor insurance portfolio characteristics and business performance - loss ratio, claim frequency, severity and pure premium by risk segment.",
    technologies: ["Power BI", "Power Query", "DAX", "Data Analysis"],
    github: "https://github.com/Eddie-Zhu-IRL/Motor-Vehicle-Insurance-Portfolio-Analysis-By-Power-BI",
    featured: false
  },
  {
    title: "Actuarial Pricing in Motor Insurance",
    category: "Insurance Ratemaking",
    description:
      "An end-to-end actuarial pricing workflow using the norauto motor insurance dataset from the CASdatasets package, to estimate the expected claim cost for each policyholder through Frequency, Severity, Pure Premium, Gross Premium.",
    technologies: ["Python", "R", "GLM"],
    github: "https://github.com/Eddie-Zhu-IRL/Motor-Insurance-Pricing",
    featured: false
  },
  {
    title: "Banking Report ETL",
    category: "Process Automation",
    description:
      "An automated Power Query workflow transforming seven daily fixed-width banking text reports into structured datasets.",
    technologies: ["Excel", "Power Query", "ETL"],
    github:
      "https://github.com/Eddie-Zhu-IRL/banking-report-etl-powerquery",
    featured: false
  },
  {
    title: "Irish Weather Rescue",
    category: "Data Quality Control & Volunteering & Reconciliation",
    description:
      "Volunteering project (Irish Weather Rescue) involving historical weather-data transcription. Initiate a quick Excel-based process of data input quality check and reconciliation.",
    technologies: ["Excel", "VBA", "Data Quality", "Reconciliation"],
    github:
      "#",
    website: 
      "https://irishweatherrescue.ie",
    featured: false
  }
];

const skills = [
  "Actuarial Science",
  "Reserving",
  "Ratemaking",
  "Statistical Modelling",
  "Excel",
  "VBA",
  "R",
  "Python",
  "Power BI",
  "Power Query",
  "DAX",
  "SQL"
];

const achievements = [
  {
    title: "MSc in Statistics",
    description: "Academic background in statistics and quantitative methods."
  },
  {
    title: "SOA Examination Progress (Society of Actuaries)",
    description: "Passed three exams: Probability, Financial Mathematics, Statistics for Risk Modeling. Completed VEE module: Mathematical Statistics"
  },
  {
    title: "CAS Essential Program",
    description: "Completed in April 2026."
  },
  {
    title: "Abacus Actuaries Student Program",
    description: "Completed in August 2026."
  },
  {
    title: "WTW Actuarial Day",
    description: "Participated in a two-day actuarial professional development event."
  },
  {
    title: "Irish Weather Rescue",
    description: "Volunteer contributing to historical weather-data transcription."
  }
];

const actuaryWords = [
  "Action",
  "Creativity",
  "Technology",
  "Uniformity",
  "Assurance",
  "Resonance",
  "Yield",
];
---

<MainLayout
  title="Eddie Zhu | Actuarial & Data Analytics Portfolio"
  description="Personal portfolio showcasing actuarial modelling, statistics, insurance analytics and data projects."
>

  
  <!-- HERO SECTION -->

  <section class="hero">
    <div class="container hero-layout">

      <!-- LEFT: Existing homepage introduction -->
      <div class="hero-content">

        <p class="eyebrow">
          ACTUARIAL SCIENCE · STATISTICS · DATA ANALYTICS
        </p>

        <h1>
          Eddie Zhu
        </h1>

        <h2>
          Applying Statistics and Data Analytics
          to Insurance Problems
        </h2>

        <p class="hero-description">
          Exploring actuarial modelling, claims reserving,
          statistical analysis and practical applications
          of data analytics through independent projects
          and professional development.
        </p>

        <div class="hero-buttons">
          <a href="/projects" class="button">
            Explore My Projects
          </a>

          <a href="/about" class="button button-outline">
            About Me
          </a>
        </div>

        <div class="social-links">
          <a
            href="https://github.com/Eddie-Zhu-IRL"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>

          <a
            href="https://www.linkedin.com/in/jingfeng-z-irl"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>
        </div>

      </div>

      <!-- RIGHT: ACTUARY panel -->
      <aside class="actuary-panel">

        <p class="panel-label">
          THE ACTUARIAL MINDSET
        </p>

        <div class="actuary-words">
          {actuaryWords.map((word) => (
            <div class="actuary-word">
              <span class="initial">{word.charAt(0)}</span>
              <span>{word.slice(1)}</span>
            </div>
          ))}
        </div>

        <p class="panel-caption">
          Seven words. One profession.
        </p>

      </aside>

    </div>
  </section>



  <!-- PROJECT SECTION -->

  <section class="section projects-section">
    <div class="container">

      <div class="section-heading">
        <div>
          <p class="eyebrow"></p>
          <h2 class="section-title">Featured Projects</h2>
          <p class="section-subtitle">
            Practical applications of actuarial science
            and data analytics.
          </p>
        </div>

        <a href="/projects" class="text-link">
          View all projects →
        </a>
      </div>

      <div class="project-grid">

        {projects.map((project) => (
          <article class="project-card">

            <div class="project-category">
              {project.category}
            </div>

            <h3>{project.title}</h3>

            <p>{project.description}</p>

            <div class="technology-list">
              {project.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>

            {project.github !== "#" && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
              >
                View GitHub Repository ↗
              </a>
            )}

            {project.website && (
              <a 
                href={project.website} 
                target="_blank" 
                rel="noopener noreferrer"
              >
                Website
              </a>
            )}

          </article>
        ))}

      </div>

    </div>
  </section>


  <!-- SKILLS SECTION -->

  <section class="section">
    <div class="container">

      <p class="eyebrow"></p>
      <h2 class="section-title">Skills & Knowledge</h2>

      <div class="skills-list">
        {skills.map((skill) => (
          <span class="skill-tag">{skill}</span>
        ))}
      </div>

      <a href="/skills" class="text-link">
        Explore my skills →
      </a>

    </div>
  </section>


  <!-- PROFESSIONAL DEVELOPMENT -->

  <section class="section achievements-section">
    <div class="container">

      <p class="eyebrow">EDUCATION & DEVELOPMENT</p>
      <h2 class="section-title">
        Professional Development
      </h2>

      <div class="achievement-grid">

        {achievements.map((achievement) => (
          <article class="achievement-card">
            <h3>{achievement.title}</h3>
            <p>{achievement.description}</p>
          </article>
        ))}

      </div>

    </div>
  </section>


  <!-- CONTACT SECTION -->

  <section class="contact-section">
    <div class="container">

      <h2>Let's Connect</h2>

      <p>
        Interested in actuarial science, insurance analytics
        or data-driven problem solving?
        Feel free to connect with me.
      </p>

      <a href="/contact" class="button">
        Get in Touch
      </a>

    </div>
  </section>

</MainLayout>


<style>


  /* HERO */

  .hero {
    background: var(--color-navy);
    color: white;
    padding: 105px 0;
  }

  /* Two-column hero layout */
  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(240px, 0.7fr);
    align-items: center;
    gap: 70px;
  }

  .hero-content {
    max-width: 720px;
  }

  .hero .eyebrow {
    color: #93C5FD;
  }

  .hero h1 {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    margin: 18px 0;
    line-height: 1.1;
  }

  .hero h2 {
    max-width: 750px;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 500;
    line-height: 1.35;
  }

  .hero-description {
    max-width: 680px;
    color: #DCE6F3;
    font-size: 1.1rem;
    margin: 25px 0;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero .button-outline {
    color: white;
    border-color: white;
  }

  .social-links {
    display: flex;
    gap: 24px;
    margin-top: 32px;
  }

  .social-links a {
    color: #BFDBFE;
    font-weight: 600;
  }

  /* ACTUARY PANEL */

  .actuary-panel {
    width: 100%;
    max-width: 300px;
    justify-self: center;
    padding: 30px;
    background: #20375A;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
  }

  .panel-label {
    color: #93C5FD;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0 0 25px;
  }

  .actuary-words {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .actuary-word {
    display: flex;
    align-items: center;
    gap: 13px;
    color: white;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .initial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 8px;
    background: #2563EB;
    color: white;
    font-weight: 700;
  }

  .panel-caption {
    color: #A9BBD1;
    font-size: 0.8rem;
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }



  /* ABOUT */

  .about-section {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 50px;
    align-items: start;
  }

  .about-description {
    color: var(--color-muted);
    margin: 0;
  }


  /* PROJECTS */

  .projects-section {
    background: #EDF2F8;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 35px;
  }

  .section-subtitle {
    color: var(--color-muted);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
  }

  .project-category {
    color: var(--color-blue);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .project-card h3 {
    color: var(--color-navy);
    font-size: 1.25rem;
    margin-bottom: 10px;
  }

  .project-card p {
    color: var(--color-muted);
    line-height: 1.7;
    flex-grow: 1;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 20px;
  }

  .technology-list span,
  .skill-tag {
    background: #EFF6FF;
    color: #1D4ED8;
    border-radius: 5px;
    padding: 6px 11px;
    font-size: 0.82rem;
  }

  .project-link,
  .text-link {
    color: var(--color-blue);
    font-weight: 600;
  }


  /* SKILLS */

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 25px 0;
  }


  /* ACHIEVEMENTS */

  .achievements-section {
    background: #EDF2F8;
  }

  .achievement-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .achievement-card {
    background: white;
    padding: 22px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .achievement-card h3 {
    color: var(--color-navy);
    font-size: 1.05rem;
  }

  .achievement-card p {
    color: var(--color-muted);
    font-size: 0.9rem;
  }


  /* CONTACT */

  .contact-section {
    background: var(--color-navy);
    color: white;
    padding: 70px 0;
    text-align: center;
  }

  .contact-section h2 {
    font-size: 2rem;
  }

  .contact-section p {
    max-width: 600px;
    margin: 0 auto 25px;
    color: #DCE6F3;
  }


  /* RESPONSIVE DESIGN */

  @media (max-width: 750px) {

    .about-section {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .achievement-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }

  }

  @media (max-width: 500px) {

    .achievement-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 75px 0;
    }

  }

</style>
